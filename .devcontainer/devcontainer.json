{
  "name": "Automatizaciones Metrix",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": { "openFiles": ["README.md", "app.py"] },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "updateContentCommand": "[ -f requirements.txt ] && pip3 install --user -r requirements.txt; echo 'Dependencias instaladas'",
  "postAttachCommand": {
    "server": "streamlit run app.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": { "label": "Aplicación", "onAutoForward": "openPreview" }
  },
  "forwardPorts": [8501]
}
